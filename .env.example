# ========================================================
# Box Storage — Environment Configuration
# ========================================================

# Password untuk login admin di web (Ganti dengan password Anda)
ADMIN_PASSWORD=admin123

# Secret key untuk sesi Flask (Acak)
FLASK_SECRET=random_secret_hex_32_characters

# PIN untuk Brankas Rahasia (Vault PIN)
VAULT_PIN=121967

# Direktori penyimpanan file (Bisa folder lokal atau mount drive)
# Linux VPS: /opt/box-storage/data atau /mnt/storage
# macOS: /Users/namauser/BoxData
# Windows: C:\BoxStorage\data
STORAGE_DIR=data

# Port dan Host aplikasi
PORT=8080
HOST=0.0.0.0
